# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: legacy HS256 JWT secret. Omit when project uses asymmetric JWKS (ES256/RS256).
SUPABASE_JWT_SECRET=
# Storage bucket for CSV uploads (default: ingest)
SUPABASE_STORAGE_BUCKET=ingest

# ── Stripe Connect (engine-only — never in Vercel / NEXT_PUBLIC_) ─
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_OAUTH_CLIENT_SECRET=
STRIPE_OAUTH_REDIRECT_URI=
# HMAC secret for OAuth CSRF state (optional; falls back to SUPABASE_JWT_SECRET)
OAUTH_STATE_SECRET=
# Where to redirect after successful Stripe OAuth callback
APP_BASE_URL=http://localhost:3000

# ── Sentry ────────────────────────────────────────────────
SENTRY_DSN=

# ── Revised audit release (all gates default closed) ────────
AUDIT_V2_ENABLED=false
AUDIT_RETENTION_APPROVED=false
BILLING_ENABLED=false
BILLING_PRICE_APPROVED=false
BILLING_LIVE_APPROVED=false
# InfFyn subscription billing; separate from customer read-only OAuth.
# Start with an approved test account. Never put these values in the app.
STRIPE_BILLING_KEY=
STRIPE_BILLING_PRICE_ID=
STRIPE_BILLING_WEBHOOK_SECRET=
# Shared with the app; signs pseudonymous public-preview visitor headers.
AUDIT_PROXY_SECRET=
# Isolated review deployment: provider actions blocked.
INFFYN_PREVIEW_MODE=false
# browser uses the stateless Vercel entrypoint without database/provider clients.
INFFYN_PREVIEW_STORAGE=browser
