{
  "name": "inffyn",
  "private": true,
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "dev:app": "npm run dev --workspace=app",
    "build:app": "npm run build --workspace=app",
    "start:app": "npm run start --workspace=app",
    "test:isolation": "tsx --env-file=app/.env --env-file=engine/.env tests/cross-tenant-isolation.test.ts",
    "test:non-member": "tsx --env-file=app/.env --env-file=engine/.env tests/authenticated-non-member-read.test.ts",
    "test:ingest": "tsx --env-file=app/.env --env-file=engine/.env tests/ingest-csv.test.ts",
    "test:middleware": "tsx tests/middleware-resilience.test.ts",
    "test:engine": "cd engine && .venv\\Scripts\\python -m pytest tests/ -v"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "@supabase/server": "^1.3.0"
  }
}
