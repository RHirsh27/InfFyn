# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Sentry ────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Engine (server-side only) ─────────────────────────────
ENGINE_URL=
# Shared with engine AUDIT_PROXY_SECRET; server-only random value, at least 32 characters.
AUDIT_PROXY_SECRET=
# Only enable on the isolated review deployment; integrations stay disabled.
INFFYN_PREVIEW_MODE=false
# browser runs hosted calculations with browser-owned saves and no database.
# database requires configured Supabase anonymous sign-in and tenant migrations.
INFFYN_PREVIEW_STORAGE=browser
