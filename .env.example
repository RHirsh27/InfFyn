# ══════════════════════════════════════════════════════════
# InfFyn — root secret reference
# Keys only. Real values live in local .env files (git-ignored).
# ══════════════════════════════════════════════════════════

# ── Supabase (shared) ─────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase CLI (for `supabase link` / `supabase db push`) ─
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# ── Next.js app (app/.env) — browser-safe public vars ─────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Sentry ────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Engine (FastAPI, engine/.env) ─────────────────────────
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY (above) also go here.
